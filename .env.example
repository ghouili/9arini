# Copy to .env.local. The app RUNS WITHOUT these (demo-data fallback),
# so you can build/see the whole UI before standing up the database.

# --- Postgres (server-side only; when set, the app uses the real DB) ---
# No Docker needed — point this at EITHER:
#   • your existing local Postgres:  postgresql://postgres:YOUR_PASSWORD@localhost:5432/qarini  (CREATE DATABASE qarini; first)
#   • a free cloud DB (Neon):        paste the connection string from your Neon project
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qarini

# Client-side flag: set to "1" once your backend is live so the UI hides the
# "demo mode" notice. (DATABASE_URL is server-only and never reaches the browser.)
NEXT_PUBLIC_BACKEND_READY=

# --- Auth (sessions + phone OTP) ---
# Secret used to hash OTP codes. Generate a real one: openssl rand -hex 32
AUTH_SECRET=dev-insecure-secret-change-me
# SMS (OTP delivery via Twilio REST — no SDK needed). Login codes are texted
# only when SID + TOKEN + (FROM *or* MESSAGING_SERVICE_SID) are all set;
# otherwise the code is shown on-screen (dev mode only — never in production).
# For Tunisia, a Messaging Service with a registered alphanumeric sender ID
# usually delivers better than a US long code. Set ONE of FROM / MESSAGING_SERVICE_SID.
# Swap for a Tunisian gateway by editing lib/sms.ts (provider-agnostic).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1XXXXXXXXXX                 # a Twilio number (delivers to +216), OR:
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxx  # recommended: Messaging Service w/ sender ID

# --- Admin (tutor verification review) ---
# Comma-separated phone numbers (same format as login, e.g. +21620123456) allowed
# to open /admin/verifications and approve/reject tutors. Empty = nobody is admin.
ADMIN_PHONES=

# --- Storage (uploaded verification documents) ---
# Dev: defaults to a local ./.storage folder. In prod, point at a persistent
# volume (e.g. Render disk mounted at /var/data) so docs survive restarts.
# STORAGE_DIR=/var/data

# --- Live video (MVP: a default Jitsi room base, or per-class links) ---
NEXT_PUBLIC_DEFAULT_MEET_BASE=https://meet.jit.si/9arini-

