# Patterns are UNANCHORED on purpose. A leading "/" anchors to the repo
# root, and once the app moved into apps/ every one of them stopped
# matching -- apps/web/.next (2208 files) went into a commit before this
# was noticed. Use "dir/" so it matches at any depth.
# Monorepo note

node_modules/
.next/
out/
.env*.local
.DS_Store
*.tsbuildinfo
next-env.d.ts

# Uploaded verification documents (sensitive — never commit)
.storage/

# Env / secrets — keep only .env.example tracked
.env
.env.*
!.env.example

# UI-audit screenshots — regenerated by `node tools/ui-audit/shots.mjs`
tools/ui-audit/shots/

# UI-audit baselines
tools/ui-audit/shots-*/

# MCP browser console logs — scratch output, regenerated per session
.playwright-mcp/

# E2E suite artifacts
.e2e-storage/
test-results/
playwright-report/
