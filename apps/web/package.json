{
  "name": "@tnajem/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:standalone": "node scripts/serve-standalone.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "echo \"BLOCKED: drizzle-kit 0.28 is not PostgreSQL 17-safe (it tries to DROP the NOT NULL constraints on ~60 columns). Use 'npm run db:sql' instead — see scripts/sql/. Details in scripts/apply-sql.ts.\" && exit 1",
    "db:push:unsafe": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "brand:build": "python scripts/brand/build-raster.py && node scripts/brand/build-og.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.4",
    "next": "^14.2.5",
    "nodemailer": "^9.0.6",
    "postgres": "^3.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "@tnajem/db": "*",
    "@tnajem/shared": "*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.5.2",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.28.1",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  }
}
