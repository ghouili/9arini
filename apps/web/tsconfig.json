{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@tnajem/db": [
        "../../packages/db/src/index.ts"
      ],
      "@tnajem/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@tnajem/shared/auth-core": [
        "../../packages/shared/src/auth-core.ts"
      ],
      "@tnajem/db/storage": [
        "../../packages/db/src/storage.ts"
      ],
      "@tnajem/shared/contracts": [
        "../../packages/shared/src/contracts/index.ts"
      ],
      "@tnajem/shared/mail": [
        "../../packages/shared/src/mail.ts"
      ],
      "@tnajem/shared/sms": [
        "../../packages/shared/src/sms.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
