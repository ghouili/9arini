{
  "name": "9arini-app",
  "version": "0.1.0",
  "private": true,
  "description": "9arini (قرّيني) — Shopify for Tunisian tutors. MVP. Local Postgres + Drizzle.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:sql": "tsx scripts/apply-sql.ts",
    "db:push": "echo \"BLOCKED: drizzle-kit 0.28 is not PostgreSQL 17-safe (it tries to DROP the NOT NULL constraints on ~60 columns). Use 'npm run db:sql' instead — see scripts/sql/. Details in scripts/apply-sql.ts.\" && exit 1",
    "db:push:unsafe": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx lib/db/seed.ts",
    "db:purge": "tsx scripts/purge-docs.ts",
    "ui:audit": "node scripts/ui-audit/contrast.mjs && node scripts/ui-audit/guardrails.mjs && node scripts/ui-audit/nojs.mjs && node scripts/ui-audit/a11y.mjs",
    "ui:shots": "node scripts/ui-audit/shots.mjs",
    "ui:weight": "node scripts/ui-audit/weight.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.4",
    "next": "^14.2.5",
    "postgres": "^3.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.5.2",
    "axe-core": "^4.13.0",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.28.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  }
}
