{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "paths": {
      "@tnajem/db": [
        "./packages/db/src/index.ts"
      ],
      "@tnajem/shared": [
        "./packages/shared/src/index.ts"
      ],
      "@tnajem/shared/auth-core": [
        "./packages/shared/src/auth-core.ts"
      ],
      "@tnajem/db/storage": [
        "./packages/db/src/storage.ts"
      ]
    }
  }
}
